rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function isAdmin() {
      return get(/databases/$(db)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    match /users/{u} {
      allow read: if request.auth != null && (request.auth.uid == u || isAdmin());
      allow create: if request.auth != null && request.auth.uid == u && request.resource.data.role == 'employee';
    }
    match /live/{u} {
      allow read: if request.auth != null && isAdmin();
      allow write: if request.auth != null && request.auth.uid == u;
    }
    match /logs/{l} {
      allow read: if request.auth != null && (isAdmin() || resource.data.uid == request.auth.uid);
      allow create: if request.auth != null && request.auth.uid == request.resource.data.uid;
    }
  }
}
