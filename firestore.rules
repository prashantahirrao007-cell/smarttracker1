rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function isAdmin() {
      return get(/databases/$(db)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    match /users/{u} {
      allow read: if request.auth != null && (request.auth.uid == u || isAdmin());
      allow create: if request.auth != null && request.auth.uid == u && request.resource.data.role == 'employee';
    }
    match /live/{u} {
      allow read: if request.auth != null && (request.auth.uid == u || isAdmin());
      allow write: if request.auth != null && request.auth.uid == u;
    }
    match /logs/{l} {
      allow read: if request.auth != null && (isAdmin() || l.matches(request.auth.uid + '_.*'));
      allow create, update: if request.auth != null && l.matches(request.auth.uid + '_.*') && request.resource.data.uid == request.auth.uid;
    }
  }
}
